{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DCS会計アプリ",
  "version": "1.0.0",
  "identifier": "com.example.dcs-accounting-app",
  "build": {
    "frontendDist": "../apps/renderer/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm nx run renderer:dev",
    "beforeBuildCommand": "pnpm nx run renderer:build"
  },
  "app": {
    "windows": [
      {
        "title": "DCS会計アプリ",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "publisher": "naro9507"
  },
  "plugins": {
    "sql": {
      "preloaded": ["sqlite:accounting.db"]
    }
  }
}
